<script>  
  // Sobrescribe la configuración de Pipedrive  
  window.pipedriveLeadboosterConfig = {  
    ...window.pipedriveLeadboosterConfig,  
    autoOpen: false  
  };  

  // Bloquea cualquier intento de abrir el chat automáticamente  
  document.addEventListener("DOMContentLoaded", () => {  
    if (window.LeadBooster) {  
      const originalTrigger = LeadBooster.trigger;  
      LeadBooster.trigger = function(event) {  
        if (event === "LeadboosterChatOpen") return;  
        originalTrigger.apply(this, arguments);  
      };  
    }  
  });  
</script>  
