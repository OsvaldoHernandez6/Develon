/*css foto con hover*/
.porto-hover-container {
    position: relative;
    display: inline-block;
}

.porto-hover-icon {
    position: absolute;
	align-items: center;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 0px;
}

.porto-hover-container:hover .porto-hover-icon {
	text-align: center;
	font-size: 25px;

  width: 30px;
    height: 30px;
    transition: all 0.3s ease-in-out;
    color: black;
}

.porto-sicon-img.porto-u-circle {
 width: 0.8em;
    min-height: 0.8em;
padding: 1.5rem;
}
