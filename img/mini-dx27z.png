                } else if ( retroexcavadora.includes(event.detail.contactFormId) ) { 
                    location = 'https://develon-ce.cl/gracias-retroexcavadora/';
                } else if ( miniexcavadoras.includes(event.detail.contactFormId) ) { 
                    location = 'https://develon-ce.cl/gracias-miniexcavadoras/';
                } else if ( dozers.includes(event.detail.contactFormId) ) { 
                    location = 'https://develon-ce.cl/gracias-dozers/';
                } else if ( gruas.includes(event.detail.contactFormId) ) { 
